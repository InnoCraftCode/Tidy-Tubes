# Copy to keystore.properties (git-ignored). Paths are relative to the project root.
# Create the upload key once (keep the .jks and passwords in a password manager, OUTSIDE the repo):
#   keytool -genkeypair -v -keystore ..\..\..\keys\mygame-upload.jks -alias upload -keyalg RSA -keysize 2048 -validity 10000
# Use Play App Signing: this is your *upload* key; Google holds the app signing key.
storeFile=../../../keys/mygame-upload.jks
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME
