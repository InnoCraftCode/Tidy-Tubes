<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Ads need network access. The GMA SDK also merges ACCESS_NETWORK_STATE and AD_ID;
         declare "Contains ads" and the advertising ID in Play Console accordingly. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Daily-puzzle reminders: local notifications only (no server, no data collected).
         Android 13+ asks the player; the game explains first and asks only after "Yes". -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Alarms do not survive a reboot; BootReceiver re-arms the saved reminder plan. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="true"
        android:fullBackupContent="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/GdxTheme">

        <!-- AdMob app ID, injected per build type from android/build.gradle.kts (demo ID in
             debug, admob.properties in release). UMP reads it from here; a missing entry
             crashes at start-up. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />

        <!-- Play Games Services project id, a string resource generated by android/build.gradle.kts
             from playgames.properties ("0" when absent: the SDK is then never initialised).
             Profile creation is not auto-prompted at launch; the player opts in from the
             Leaderboards button. -->
        <meta-data
            android:name="com.google.android.gms.games.APP_ID"
            android:value="@string/game_services_project_id" />
        <meta-data
            android:name="com.google.android.gms.games.SUPPRESS_GAME_PROFILE_CREATION"
            android:value="true" />

        <!-- Firebase Analytics / Crashlytics start switched off; AndroidLauncher enables them only
             after the consent flow allows it, and never in debug builds. -->
        <meta-data
            android:name="firebase_analytics_collection_enabled"
            android:value="false" />
        <meta-data
            android:name="firebase_crashlytics_collection_enabled"
            android:value="false" />

        <!-- No android:screenOrientation here: Play Console flags fixed orientations as
             large-screen restrictions and Android 16 ignores them above sw600dp. AndroidLauncher
             keeps phone-sized windows in portrait at runtime; larger ones rotate freely. -->
        <activity
            android:name=".android.AndroidLauncher"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/GdxTheme">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Share sheet: exposes files/share/ (the result card PNG) read-only, per share. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.share"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/share_paths" />
        </provider>

        <!-- Posts a scheduled reminder. Only our own alarms reach it. -->
        <receiver
            android:name=".android.ReminderReceiver"
            android:exported="false" />

        <!-- BOOT_COMPLETED is a protected system broadcast, so exporting this is safe. -->
        <receiver
            android:name=".android.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
