<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        Display cutouts arrived in API 27. Kept in its own qualified folder rather than behind a
        lint suppression, so the base theme stays valid on API 24-26.
    -->
    <style name="GdxTheme" parent="android:Theme.Black.NoTitleBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

</resources>
