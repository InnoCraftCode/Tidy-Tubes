    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3.4"
        android:strokeLineCap="round"
        android:pathData="M43,42 L43,69.5 A11,11 0 0 0 65,69.5 L65,42" />
    <!-- Balls inside the tube. -->
    <path android:fillColor="#FFFFFFFF" android:pathData="M54,70 m-7.6,0 a7.6,7.6 0 1 0 15.2,0 a7.6,7.6 0 1 0 -15.2,0" />
    <path android:fillColor="#FFFFFFFF" android:pathData="M54,54 m-7.6,0 a7.6,7.6 0 1 0 15.2,0 a7.6,7.6 0 1 0 -15.2,0" />
    <!-- The lifted ball. -->
    <path android:fillColor="#FFFFFFFF" android:pathData="M54,31 m-7.6,0 a7.6,7.6 0 1 0 15.2,0 a7.6,7.6 0 1 0 -15.2,0" />
