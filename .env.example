# Environment variables the tools understand. Nothing loads this file automatically: set them in
# your user environment (setx NAME "value", then open a new terminal) only if you need them.
# Never put passwords, keystores or tokens here - signing secrets go in each game's git-ignored
# keystore.properties, ad unit IDs in admob.properties.

# Android SDK. Optional: tools fall back to %LOCALAPPDATA%\Android\Sdk.
ANDROID_HOME=C:\Users\<you>\AppData\Local\Android\Sdk

# JDK used by Gradle (21). Already set on this machine.
JAVA_HOME=C:\Program Files\Eclipse Adoptium\jdk-21.0.12.101-hotspot
